{
  "schema_version": 1,
  "project": "FROSTMOURNE",
  "target": {
    "product": "World of Warcraft",
    "version": "3.3.5a",
    "build": 12340,
    "platform": "Windows",
    "architecture": "x86"
  },
  "entrypoints": {
    "ai_rules": "AGENTS.md",
    "ai_start": "AI_START_HERE.md",
    "stable": "CURRENT.json",
    "runtime": "runtime/current.json",
    "workflow": "docs/WORKFLOW.md",
    "target_client": "reference/client/reference.json",
    "updater_release": "updates/work.json"
  },
  "modules": [
    {
      "id": "updater",
      "source": "src/updater",
      "docs": "docs/UPDATER.md",
      "platform": "Windows x86",
      "status": "experimental",
      "distribution": "GitHub Actions artifact frostmourne-updater-win-x86",
      "release_manifest": "updates/work.json"
    },
    {
      "id": "gui-loader",
      "source": "src/loader",
      "docs": "docs/GUI_LOADER_TEST.md",
      "platform": "Windows x86",
      "status": "experimental",
      "distribution": "GitHub Actions artifact frostmourne-gui-loader-x86",
      "active_runtime": false
    },
    {
      "id": "auto-pickpocket",
      "source": "src/auto_pickpocket",
      "docs": "docs/AUTO_PICKPOCKET.md",
      "platform": "Windows x86 test bootstrap (client-independent C core)",
      "status": "experimental-inprocess-core-only-no-gameplay-adapter",
      "distribution": "GitHub Actions frostmourne-gui-loader-x86: ABI and inert core status test, no Pick Pocket actions",
      "active_runtime": false
    },
    {
      "id": "auto-interrupt",
      "source": "src/auto_interrupt",
      "docs": "docs/AUTO_INTERRUPT.md",
      "platform": "Windows x86",
      "status": "experimental-decision-engine-only",
      "distribution": null,
      "active_runtime": false,
      "client_adapter_verified": false
    }
  ],
  "tools": [
    {
      "id": "verify_repo",
      "path": "tools/verify_repo.py",
      "purpose": "Repository structure, manifest relationships, baseline and canonical-source checks."
    },
    {
      "id": "verify_current",
      "path": "tools/verify_current.py",
      "purpose": "Active runtime integrity, SHA256, PE architecture, dependencies and compatibility checks."
    },
    {
      "id": "verify_reference_client",
      "path": "tools/verify_reference_client.py",
      "purpose": "Verify the exact registered WoW 3.3.5a build 12340 x86 client fingerprint before client-dependent work."
    },
    {
      "id": "package_runtime",
      "path": "tools/make_runtime_package.py",
      "purpose": "Create deterministic ZIP from the active runtime manifest."
    },
    {
      "id": "audit_reference_client",
      "path": "tools/audit_reference_client.py",
      "purpose": "Read-only fingerprint-gated PE audit; compare against committed measured report."
    },
    {
      "id": "package_gui_loader",
      "path": "tools/package_gui_loader.py",
      "purpose": "Verify native x86 bootstrap ABI, managed x86 GUI, SHA256 pin and isolated GUI loader ZIP."
    },
    {
      "id": "audit_interrupt_addresses",
      "path": "tools/audit_interrupt_addresses.py",
      "purpose": "Read-only candidate-address disassembly against the exact registered 12340 x86 image."
    }
  ],
  "docs": [
    "docs/WORKFLOW.md",
    "docs/MANIFESTS.md",
    "docs/BASELINES.md",
    "reference/client/README.md",
    "docs/CLIENT_PE_AUDIT.md",
    "docs/LOADER_UPDATER_ARCHITECTURE.md",
    "reference/client/pe_audit.json",
    "docs/UPDATER.md",
    "docs/GUI_LOADER_TEST.md",
    "docs/AUTO_PICKPOCKET.md"
  ]
}
